{
  "permissions": {
    "allow": [
      "Write(minhas-empresas/**)",
      "Read(minhas-empresas/**)",
      "Read(.claude/agents/**)",
      "Read(.claude/skills/**)",
      "Read(.claude/commands/**)",
      "Write(.claude/agents-memory/**)",
      "Read(.claude/agents-memory/**)",
      "Bash(ls *)",
      "Bash(curl *)",
      "Bash(mktemp)",
      "Bash(rm /tmp/*)",
      "Read(.env)",
      "Edit(.env)",
      "Bash(git pull*)",
      "Bash(node *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BEFORE=$(git rev-parse HEAD 2>/dev/null); git pull --ff-only --quiet 2>/dev/null || true; AFTER=$(git rev-parse HEAD 2>/dev/null); if [ \"$BEFORE\" != \"$AFTER\" ] && [ -n \"$AFTER\" ]; then printf '{\"systemMessage\": \"Vetria atualizada com as últimas melhorias.\"}'; fi",
            "timeout": 15,
            "statusMessage": "Verificando atualizações da matriz Vetria..."
          }
        ]
      }
    ]
  }
}
