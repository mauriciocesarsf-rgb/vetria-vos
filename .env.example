# ══════════════════════════════════════════
# Canal do Gerente IA (credenciais compartilhadas, dois destinos)
# ══════════════════════════════════════════
# Usado por: /configurar-canal-relatorio, /gerente-enviar-relatorio, /gerente-boas-vindas-mes
# Valor: TELEGRAM ou WHATSAPP
GERENTE_CANAL_RELATORIO=

# ── Telegram (recomendado: gratuito, sem risco de bloqueio) ──
# Usado por: /configurar-telegram
# Preenchido sozinho na instalação do app (bot compartilhado) — normalmente
# não precisa mexer aqui. Só fica vazio de propósito neste .env.example.
TELEGRAM_BOT_TOKEN=

# Chat ID do GRUPO da loja — usado por /gerente-enviar-relatorio (relatório de faturamento/ranking, toda a equipe vê)
TELEGRAM_CHAT_ID_GRUPO=

# Chat ID do GERENTE (conversa individual com o próprio gerente) — usado por /gerente-boas-vindas-mes
# (análises individuais por vendedor, só o gerente vê e decide o que encaminhar)
TELEGRAM_CHAT_ID_GERENTE=

# Chat ID que recebe aviso se o envio automático falhar — usado por /configurar-envio-automatico
# Opcional — sem isso, uma falha só fica registrada internamente, ninguém é avisado.
TELEGRAM_CHAT_ID_ERRO=

# ── WhatsApp via Z-API (risco real de banimento do número conectado) ──
# Usado por: /configurar-whatsapp
# Obter em: https://app.z-api.io (siga /configurar-whatsapp)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Destino do GRUPO da loja — usado por /gerente-enviar-relatorio
# GERENTE_WHATSAPP_TIPO_GRUPO = CONTATO ou GRUPO
GERENTE_WHATSAPP_TIPO_GRUPO=
GERENTE_WHATSAPP_DESTINO_GRUPO=

# Número pessoal do GERENTE (sempre um contato individual) — usado por /gerente-boas-vindas-mes
GERENTE_WHATSAPP_DESTINO_GERENTE=

# ══════════════════════════════════════════
# Envio automático (frequência e horário)
# ══════════════════════════════════════════
# Usado por: /configurar-envio-automatico
# Valor: DIARIO, SEMANAL ou MENSAL
GERENTE_FREQUENCIA_RELATORIO=

# Horário do envio automático, formato HH:mm (fuso America/Sao_Paulo)
GERENTE_HORARIO_RELATORIO=

# ══════════════════════════════════════════
# Geração de imagem (Gerente IA, Vetria Marketing e Vetria Stylist)
# ══════════════════════════════════════════
# Usado por: skill gerar-imagem
# Preenchidos sozinhos pelo app (mesmo padrão do TELEGRAM_BOT_TOKEN) — a
# geração roda através do servidor da Vetria, com teto mensal por loja, sem
# precisar de conta ou chave própria da loja. Normalmente não precisa mexer
# aqui. Só ficam vazios de propósito neste .env.example.
VETRIA_BACKEND_URL=
VETRIA_SYNC_API_KEY=
VETRIA_CLIENTE_SLUG=

# ══════════════════════════════════════════
# Suporte (contato com o administrador da plataforma)
# ══════════════════════════════════════════
# Usado por: /configurar-suporte, /falar-com-suporte
# Chat ID do Telegram de quem administra essa instalação do Vetria VOS
# (reaproveita TELEGRAM_BOT_TOKEN acima, se já estiver configurado).
# Opcional — sem isso, /falar-com-suporte só salva a mensagem localmente.
VOS_ADMIN_TELEGRAM_CHAT_ID=
